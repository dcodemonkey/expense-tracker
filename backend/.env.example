# Environment: "development" (ephemeral SECRET_KEY allowed) or "production" (SECRET_KEY required)
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/expense_tracker

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset in development, an ephemeral key is generated (tokens reset on restart).
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_TOKEN_EXPIRE_HOURS=24

# URLs
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:8501
# Extra CORS origins, comma-separated (FRONTEND_URL and ADMIN_URL are always allowed)
BACKEND_CORS_ORIGINS=

# Admin bootstrap: comma-separated emails promoted to admin on startup
ADMIN_EMAILS=

# API
API_V1_STR=/api/v1
PROJECT_NAME=Expense Tracker API
VERSION=0.1.0

# Email / SMTP (optional). Leave SMTP_HOST empty to log verification/reset links
# to the console instead of sending real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM=noreply@expensetracker.com

# SMS/Email Parser API Keys (optional)
SMS_PARSER_API_KEY=
EMAIL_PARSER_API_KEY=
